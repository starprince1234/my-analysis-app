# Flask application secret. Use a long random value in production.
SECRET_KEY=your_secret_key_here

# Optional Flask runtime settings.
FLASK_ENV=development
FLASK_DEBUG=1

# Upload and result directories. Defaults match the Docker and local setup.
UPLOAD_FOLDER=uploads
RESULT_FOLDER=results

# Maximum upload size in megabytes.
MAX_CONTENT_LENGTH_MB=50

# Socket.IO CORS origins. Use a comma-separated list in production.
CORS_ALLOWED_ORIGINS=*
